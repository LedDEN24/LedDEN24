[Unit]
Description=Цветочный Atrium (Django via Gunicorn)
After=network.target

[Service]
User=atrium
Group=www-data
WorkingDirectory=/home/atrium/app
EnvironmentFile=/home/atrium/app/.env
ExecStart=/home/atrium/app/venv/bin/gunicorn config.wsgi:application --bind 127.0.0.1:8000 --workers 3 --timeout 60
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
