# REG.RU shared hosting example
DJANGO_SECRET_KEY=CHANGE_ME_TO_A_LONG_RANDOM_SECRET
DJANGO_DEBUG=0
DJANGO_ALLOWED_HOSTS=your-domain.ru,www.your-domain.ru
DJANGO_CSRF_TRUSTED_ORIGINS=https://your-domain.ru,https://www.your-domain.ru
SITE_URL=https://your-domain.ru

# Database
# SQLite works by default on REG.RU shared hosting.
# Leave DATABASE_URL empty unless you explicitly switch to another DB.
# DATABASE_URL=

# Telegram bot
# Leave empty on REG.RU shared hosting unless you move the bot to webhooks on another worker.
TG_BOT_TOKEN=
TG_ADMIN_IDS=
TG_SUPPORT_USERNAME=

# YooKassa
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=
YOOKASSA_WEBHOOK_SECRET=
